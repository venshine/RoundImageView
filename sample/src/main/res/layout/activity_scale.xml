<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_padding"
        android:paddingTop="16dp"
        android:paddingEnd="@dimen/page_padding"
        android:paddingBottom="24dp">

        <include layout="@layout/include_toolbar" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_segment"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/source_portrait"
                style="@style/Text.Numeric"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_segment_item"
                android:gravity="center"
                android:text="@string/scale_portrait"
                android:textColor="@color/segment_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/source_landscape"
                style="@style/Text.Numeric"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_segment_item"
                android:gravity="center"
                android:text="@string/scale_landscape"
                android:textColor="@color/segment_text"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="0dp"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <com.wx.ovalimageview.RoundImageView
                        android:id="@+id/image_center_crop"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:background="@drawable/bg_segment"
                        android:scaleType="centerCrop"
                        android:src="@drawable/demo_portrait"
                        app:border_color="@color/accent"
                        app:border_width="3dp"
                        app:circle="true" />

                    <TextView
                        style="@style/Text.Mono"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="centerCrop"
                        android:textColor="@color/text"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <com.wx.ovalimageview.RoundImageView
                        android:id="@+id/image_fit_center"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:background="@drawable/bg_segment"
                        android:scaleType="fitCenter"
                        android:src="@drawable/demo_portrait"
                        app:border_color="@color/accent"
                        app:border_width="3dp"
                        app:circle="true" />

                    <TextView
                        style="@style/Text.Mono"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="fitCenter"
                        android:textColor="@color/text"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <com.wx.ovalimageview.RoundImageView
                        android:id="@+id/image_center_inside"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:background="@drawable/bg_segment"
                        android:scaleType="centerInside"
                        android:src="@drawable/demo_portrait"
                        app:border_color="@color/accent"
                        app:border_width="3dp"
                        app:circle="true" />

                    <TextView
                        style="@style/Text.Mono"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="centerInside"
                        android:textColor="@color/text"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="@color/border" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/circle_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="52dp"
                android:text="@string/scale_circle"
                android:textColor="@color/text"
                android:textSize="15sp" />

        </LinearLayout>

        <TextView
            style="@style/Text.Note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/scale_hint" />

    </LinearLayout>
</ScrollView>
